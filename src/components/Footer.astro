---
import { format, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { footer } = t(Astro.props.lang);
// Year of the build: the site is static, so it refreshes on every deploy.
const year = new Date().getFullYear();
---
<footer class="site-footer">
  {format(footer.copyright, { year })} · <a href="https://motyl.dev">{footer.link}</a>
</footer>

<style>
  .site-footer {
    max-width: 1100px; margin: 0 auto; padding: 16px; border-top: 1px solid var(--line);
    font-size: .88rem; color: var(--muted);
  }
</style>
